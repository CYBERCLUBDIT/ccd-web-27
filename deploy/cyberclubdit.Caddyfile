cyberclubdit.org {
    encode zstd gzip
    reverse_proxy cyberclubdit-web:3000
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
}

www.cyberclubdit.org {
    redir https://cyberclubdit.org{uri} permanent
}
